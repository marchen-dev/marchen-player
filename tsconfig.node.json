{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "Bundler",
    "paths": {
      "@pkg": ["./package.json"],
      "@marchen/sparkle-updater": ["./packages/sparkle-updater/src/index.ts"],
      "@main/*": ["./src/main/*"],
      "@marchen/electron-ipc/*": ["./packages/electron-ipc/src/*"],
      "@marchen/shared/*": ["./packages/shared/src/*"]
    },
    "types": ["electron-vite/node"]
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "types/**/*.d.ts",
    "packages/electron-ipc/src/**/*",
    "packages/shared/src/**/*"
  ]
}
