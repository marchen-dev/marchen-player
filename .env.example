VITE_API_URL=https://dandan-proxy.suemor.com/api/v2
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# 开发环境默认不上报；仅在需要验证遥测链路时临时开启。
VITE_TELEMETRY_DEBUG=false

# 仅 Electron 开发态验收使用：设为 1 时强制视频转码，生产构建会忽略。
# 开发态可选：audio / safe / hdr-sdr。生产构建会忽略。
VITE_FORCE_TRANSCODE_PROFILE=
# 兼容旧开发开关；1 等价于 VITE_FORCE_TRANSCODE_PROFILE=safe。
VITE_FORCE_VIDEO_TRANSCODE=0

# 只供 Source Map 构建插件使用，严禁添加 VITE_ 前缀。
SENTRY_AUTH_TOKEN=
SENTRY_ORG=marchen-dev
SENTRY_PROJECT=marchen-player

# mac 公证
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
APPLE_APP_BUNDLE_ID=
