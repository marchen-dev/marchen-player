VITE_API_CLOUDFLARE_URL=https://dandan-proxy.suemor.cc/api/v2
VITE_API_EDGEONE_URL=https://dandan-proxy.suemor.com/api/v2
# API 请求签名（与 dandan-proxy 的 SIGN_KEYS 对应）。Web 用 w1、桌面发行用 d1；正式构建必填。
# 密钥会随客户端分发，不要使用任何在别处使用的密码。本地留空则不签名，
# 但代理对 Web 切到 enforce 后 localhost 请求会被拒绝，建议本地配置 w1。
VITE_API_SIGN_KID=
VITE_API_SIGN_KEY=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# 开发环境默认不上报；仅在需要验证遥测链路时临时开启。
VITE_TELEMETRY_DEBUG=false

# 并行 E2E 可在 shell 设置 MARCHEN_DEV_USER_DATA_DIR=/absolute/test/profile，隔离数据和单实例锁。

# 只供 Source Map 构建插件使用，严禁添加 VITE_ 前缀。
SENTRY_AUTH_TOKEN=
SENTRY_ORG=marchen-dev
SENTRY_PROJECT=marchen-player

# EdgeOne 正式构建必填，各环境分别配置 preview / production。
MARCHEN_DEPLOY_ENV=
