VITE_API_URL=https://dandan-proxy.suemor.com/api/v2
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# 开发环境默认不上报；仅在需要验证遥测链路时临时开启。
VITE_TELEMETRY_DEBUG=false

# @deprecated 仅为旧验收脚本保留；请改用 VITE_MEDIA_FORCE_METHOD。
# 旧值 audio 映射 direct-stream，safe / hdr-sdr 映射 transcode。
VITE_FORCE_TRANSCODE_PROFILE=
# @deprecated 1 映射 VITE_MEDIA_FORCE_METHOD=transcode。
VITE_FORCE_VIDEO_TRANSCODE=0
# 新旧媒体 planner 迁移：legacy / shadow / generalized，仅开发态生效。
VITE_MEDIA_COMPAT_PLANNER=legacy
# 通用 planner 开发 override（仅 Electron dev）。
VITE_MEDIA_FORCE_METHOD=
VITE_MEDIA_FORCE_VIDEO_DECODER=
VITE_MEDIA_FORCE_VIDEO_ENCODER=
VITE_MEDIA_FORCE_AUDIO_ENCODER=
# 稳定 Dynamic HLS v2 路由迁移开关；默认继续使用 v1 generation transport。
VITE_MEDIA_GATEWAY_V2=0
# 并行 E2E 可在 shell 设置 MARCHEN_DEV_USER_DATA_DIR=/absolute/test/profile，隔离数据和单实例锁。

# 可选本地真实媒体 smoke。仅填写在个人 .env/shell 中；不要提交路径或媒体内容。
MARCHEN_SMOKE_HEVC_MAIN10_HDR_EAC3=
MARCHEN_SMOKE_HEVC_MAIN10_SDR_FLAC=
MARCHEN_SMOKE_AV1=
MARCHEN_SMOKE_VP9=
MARCHEN_SMOKE_VC1=
MARCHEN_SMOKE_MPEG2=
MARCHEN_SMOKE_LONG_GOP=
MARCHEN_SMOKE_VFR_NONZERO_START=

# 只供 Source Map 构建插件使用，严禁添加 VITE_ 前缀。
SENTRY_AUTH_TOKEN=
SENTRY_ORG=marchen-dev
SENTRY_PROJECT=marchen-player

# mac 公证
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
APPLE_APP_BUNDLE_ID=
