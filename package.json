{
  "name": "Marchen",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Marchen player",
  "author": "Suemor",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/marchen-dev/marchen-player",
  "repository": {
    "url": "https://github.com/marchen-dev/marchen-player",
    "type": "git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "build": "pnpm typecheck && electron-vite build",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:web": "rm -rf out/web && vite build",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "bump": "vv",
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "format": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "prepare": "pnpm exec simple-git-hooks",
    "start": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/openai": "^4.0.51",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ai": "^7.0.84",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/notarize": "^3.1.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@ffmpeg-installer/darwin-arm64": "^4.1.5",
    "@ffprobe-installer/darwin-arm64": "^5.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify/tailwind4": "^1.2.3",
    "@jellyfin/libass-wasm": "^4.2.4",
    "@marchen/electron-ipc": "workspace:*",
    "@marchen/shared": "workspace:*",
    "@sentry/react": "^10.71.0",
    "@suemor/xgplayer": "^3.0.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^24.13.3",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/string-natural-compare": "^3.0.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "click-to-react-component": "^1.1.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "danmu.js": "^1.2.1",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.1.1",
    "jotai": "^2.20.3",
    "lint-staged": "^17.4.1",
    "lodash-es": "^4.18.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.35.0",
    "nbump": "^2.1.8",
    "next-themes": "^0.4.6",
    "node-machine-id": "^1.1.12",
    "ofetch": "^1.5.1",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "react-scan": "0.5.7",
    "simple-git-hooks": "^2.13.1",
    "spark-md5": "^3.0.2",
    "string-natural-compare": "^3.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "bump": {
    "before": [
      "git pull --rebase"
    ],
    "commit_message": "chore(release): release v${NEW_VERSION}",
    "changelog": true
  }
}
