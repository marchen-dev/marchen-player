{
  "name": "Marchen",
  "type": "module",
  "version": "1.1.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "Marchen player",
  "desktopName": "marchen.desktop",
  "author": "Suemor",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/marchen-dev/marchen-player",
  "repository": {
    "url": "https://github.com/marchen-dev/marchen-player",
    "type": "git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "build": "pnpm media:prepare && pnpm typecheck && electron-vite build",
    "build:linux": "pnpm build && electron-builder --linux --publish never",
    "build:mac": "pnpm build && pnpm sparkle:build && electron-builder --mac --arm64 --publish never",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:web": "pnpm media:prepare && rm -rf out/web && vite build",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "bump": "vv",
    "dev": "pnpm media:prepare && electron-vite dev",
    "dev:web": "pnpm media:prepare && vite",
    "format": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "prepare": "pnpm exec simple-git-hooks",
    "start": "electron-vite preview",
    "test:main": "vitest run --config vitest.main.config.ts",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "media:prepare": "node scripts/player-engine/prepare-libav.mjs && node scripts/player-engine/prepare-audio.mjs",
    "build:web:release": "node scripts/web/release-build.mjs",
    "test:player-runtime": "vitest run --config vitest.player-runtime.config.ts",
    "sparkle:build": "node packages/sparkle-updater/scripts/build.mjs",
    "sparkle:test-versions": "node packages/sparkle-updater/scripts/test-versions.mjs",
    "test:downloads:engine": "node scripts/downloads/verify-engine.mjs",
    "test:downloads:utility": "electron scripts/downloads/utility-probe.cjs"
  },
  "dependencies": {
    "@mediabunny/ac3": "1.62.1",
    "@mediabunny/dts": "1.62.1",
    "@sentry/electron": "7.17.0",
    "@soundtouchjs/audio-worklet": "2.1.1",
    "@suemor/libav-hevc": "0.1.1",
    "@tanstack/react-virtual": "^3.14.14",
    "bencode": "4.0.1",
    "mediabunny": "1.62.1",
    "memory-chunk-store": "1.3.5",
    "nanoid": "^6.0.2",
    "parse-torrent": "11.0.24",
    "posthog-js": "1.438.7",
    "radix-ui": "^1.7.0",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/asar": "4.3.1",
    "@eslint-react/eslint-plugin": "^5.26.0",
    "@fontsource/manrope": "^5.3.0",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify/tailwind4": "^1.2.3",
    "@jellyfin/libass-wasm": "^4.2.4",
    "@marchen/electron-ipc": "workspace:*",
    "@marchen/shared": "workspace:*",
    "@sentry/react": "10.70.0",
    "@sentry/vite-plugin": "5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^24.13.3",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/string-natural-compare": "^3.0.4",
    "@types/webtorrent": "^3.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "click-to-react-component": "^1.1.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0-beta.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^13.1.1",
    "jotai": "^2.20.3",
    "lint-staged": "^17.6.0",
    "lodash-es": "^4.18.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.55.0",
    "nbump": "^2.1.8",
    "next-themes": "^0.4.6",
    "node-machine-id": "^1.1.12",
    "ofetch": "^1.5.1",
    "opencc-js": "1.4.2",
    "playwright-core": "1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-scan": "0.5.7",
    "rxjs": "7.8.2",
    "simple-git-hooks": "^2.14.0",
    "spark-md5": "^3.0.2",
    "string-natural-compare": "^3.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "xml2js": "^0.6.2",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "bump": {
    "before": [
      "git pull --rebase"
    ],
    "commit_message": "chore(release): release v${NEW_VERSION}",
    "changelog": true
  }
}
